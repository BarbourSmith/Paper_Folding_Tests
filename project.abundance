                  "interpreterVersion": 1,
                  "code": "/**\n * The spherical surface of one gore (a lune between two meridians),\n * returned as a Face so crv.MeshUnroll can flatten it.\n * The wedge is centred on -X to keep the sphere's seam (on +X) out of it.\n */\nfunction run(radius: number = 100, gores: number = 12): Assembly {\n  const a = Math.PI / gores;\n  const big = radius * 3;\n  const p = (t: number): [number, number] => [big * Math.cos(Math.PI + t), big * Math.sin(Math.PI + t)];\n  const wedge = replicad\n    .draw([0, 0])\n    .lineTo(p(-a))\n    .lineTo(p(a))\n    .close()\n    .sketchOnPlane(\"XY\", [0, 0, -big])\n    .extrude(2 * big);\n  const lune = replicad.makeSphere(radius).intersect(wedge);\n  const faces = lune.faces.filter((f) => f.geomType === \"SPHERE\");\n  if (faces.length !== 1) throw new Error(`expected 1 spherical face, got ${faces.length}`);\n  return new Assembly({ geometry: faces[0] });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * The spherical surface of one gore (a lune between two meridians),\n * returned as a Face so crv.MeshUnroll can flatten it.\n * The wedge is centred on -X to keep the sphere's seam (on +X) out of it.\n */\nfunction run(radius = 100, gores = 12) {\n    const a = Math.PI / gores;\n    const big = radius * 3;\n    const p = (t) => [big * Math.cos(Math.PI + t), big * Math.sin(Math.PI + t)];\n    const wedge = replicad\n        .draw([0, 0])\n        .lineTo(p(-a))\n        .lineTo(p(a))\n        .close()\n        .sketchOnPlane(\"XY\", [0, 0, -big])\n        .extrude(2 * big);\n    const lune = replicad.makeSphere(radius).intersect(wedge);\n    const faces = lune.faces.filter((f) => f.geomType === \"SPHERE\");\n    if (faces.length !== 1)\n        throw new Error(`expected 1 spherical face, got ${faces.length}`);\n    return new Assembly({ geometry: faces[0] });\n}\n"
