              "interpreterVersion": 1,
              "code": "/**\n * Adds glue tabs to a flat outline (e.g. from crv.MeshUnroll) using the\n * \"first half of every edge\" rule: the outline is split into edges at its\n * sharp corners, and each edge gets tabs along its first half (walking the\n * outline counter-clockwise). When two pieces are glued along an edge they\n * run in opposite directions, so one piece's tabs always land on the other\n * piece's plain half - any piece can be glued to any other.\n * Each tab's fold line is scored with short slots that stop short of the cut.\n */\nfunction run(\n  outline: Assembly,\n  tabWidth: number = 8,\n  tabsPerHalfEdge: number = 3,\n  cornerDeg: number = 25,\n): Assembly {\n  return outline.onLeafs((leaf) => {\n    let pts = outlinePoints(leaf.geometry);\n    if (area(pts) < 0) pts.reverse();\n    const n = pts.length;\n    // corners: vertices where the outline turns sharply\n    const corners: number[] = [];\n    for (let i = 0; i < n; i++) {\n      const a = pts[(i + n - 1) % n];\n      const b = pts[i];\n      const c = pts[(i + 1) % n];\n      let turn = Math.abs(Math.atan2(c[1] - b[1], c[0] - b[0]) - Math.atan2(b[1] - a[1], b[0] - a[0]));\n      if (turn > Math.PI) turn = 2 * Math.PI - turn;\n      if (turn > (cornerDeg * Math.PI) / 180) corners.push(i);\n    }\n    if (corners.length < 2) throw new Error(`found ${corners.length} corners; lower cornerDeg`);\n    // start the outline at the first corner\n    pts = [...pts.slice(corners[0]), ...pts.slice(0, corners[0])];\n    const cum = ringCum(pts);\n    // corner positions along the outline, merging any within 3 mm of each other\n    const cs: number[] = [];\n    for (const c of corners.map((c) => cum[(c - corners[0] + n) % n]).sort((a, b) => a - b)) {\n      if (cs.length === 0 || c - cs[cs.length - 1] > 3) cs.push(c);\n    }\n    console.log(`${n} outline points, ${cs.length} edges`);\n    const ranges: [number, number][] = [];\n    for (let k = 0; k < cs.length; k++) {\n      const s0 = cs[k];\n      const s1 = k + 1 < cs.length ? cs[k + 1] : cum[n];\n      const start = s0 + 2;\n      const end = s0 + (s1 - s0) / 2 - 1;\n      const slot = (end - start) / tabsPerHalfEdge;\n      for (let j = 0; j < tabsPerHalfEdge; j++) ranges.push([start + j * slot + 1, start + (j + 1) * slot - 1]);\n    }\n    // new Assembly without the source's heat-map metadata, which no longer matches\n    return new Assembly({ geometry: withScores(addTabs(pts, ranges, tabWidth), scoreSlots(pts, ranges)) });\n  });\n}\n\ntype P = [number, number];\n\n/** Ordered outline points of a single-loop drawing, chained from its edges. */\nfunction outlinePoints(drawing: any): P[] {\n  const segs: [P, P][] = drawing.sketchOnPlane(\"XY\").wire.edges.map((e: any) => [\n    [e.startPoint.x, e.startPoint.y],\n    [e.endPoint.x, e.endPoint.y],\n  ]);\n  const dist = (p: P, q: P) => Math.hypot(p[0] - q[0], p[1] - q[1]);\n  const used = new Array(segs.length).fill(false);\n  const pts: P[] = [segs[0][0]];\n  let cur = segs[0][1];\n  used[0] = true;\n  for (let step = 1; step < segs.length; step++) {\n    pts.push(cur);\n    // nearest unused segment end to the current point\n    let best = -1;\n    let flip = false;\n    let bestD = Infinity;\n    for (let i = 0; i < segs.length; i++) {\n      if (used[i]) continue;\n      const da = dist(segs[i][0], cur);\n      const db = dist(segs[i][1], cur);\n      if (da < bestD) [bestD, best, flip] = [da, i, false];\n      if (db < bestD) [bestD, best, flip] = [db, i, true];\n    }\n    if (best < 0 || bestD > 0.01) {\n      console.warn(`outline chain broke after ${step} of ${segs.length} edges`);\n      break;\n    }\n    used[best] = true;\n    cur = flip ? segs[best][0] : segs[best][1];\n  }\n  return pts;\n}\n\nfunction area(pts: P[]): number {\n  let s = 0;\n  for (let i = 0; i < pts.length; i++) {\n    const p = pts[i];\n    const q = pts[(i + 1) % pts.length];\n    s += p[0] * q[1] - q[0] * p[1];\n  }\n  return s / 2;\n}\n\n/** Cumulative arc length at each vertex of the closed outline (last = perimeter). */\nfunction ringCum(pts: P[]): number[] {\n  const cum = [0];\n  for (let i = 1; i <= pts.length; i++) {\n    const a = pts[i - 1];\n    const b = pts[i % pts.length];\n    cum.push(cum[i - 1] + Math.hypot(b[0] - a[0], b[1] - a[1]));\n  }\n  return cum;\n}\n\n/**\n * Adds glue tabs to a closed counter-clockwise outline. Each range [s0, s1]\n * is an arc-length interval measured along the outline from pts[0]; the tab\n * follows the outline over that interval, pushed outward by `w`, with\n * 45-degree tapered ends so neighbouring tabs don't collide at corners.\n */\nfunction addTabs(pts: P[], ranges: [number, number][], w: number): P[] {\n  const ring: P[] = [...pts, pts[0]];\n  const cum = ringCum(pts);\n  const segAt = (s: number) => {\n    let i = 0;\n    while (i < ring.length - 2 && cum[i + 1] <= s) i++;\n    return i;\n  };\n  const at = (s: number): P => {\n    const i = segAt(s);\n    const t = (s - cum[i]) / (cum[i + 1] - cum[i] || 1);\n    return [ring[i][0] + t * (ring[i + 1][0] - ring[i][0]), ring[i][1] + t * (ring[i + 1][1] - ring[i][1])];\n  };\n  // outward (right-hand) unit normal of segment i\n  const nrm = (i: number): P => {\n    const dx = ring[i + 1][0] - ring[i][0];\n    const dy = ring[i + 1][1] - ring[i][1];\n    const l = Math.hypot(dx, dy) || 1;\n    return [dy / l, -dx / l];\n  };\n  const shift = (p: P, n: P): P => [p[0] + n[0] * w, p[1] + n[1] * w];\n  const out: P[] = [];\n  let v = 0;\n  for (const [s0, s1] of [...ranges].sort((a, b) => a[0] - b[0])) {\n    if (s1 - s0 < 1e-6) continue;\n    while (v < pts.length && cum[v] < s0) out.push(ring[v++]);\n    const taper = Math.min(w, (s1 - s0) / 3);\n    const a = s0 + taper;\n    const b = s1 - taper;\n    out.push(at(s0));\n    out.push(shift(at(a), nrm(segAt(a))));\n    for (let j = 1; j < pts.length; j++) {\n      if (cum[j] > a && cum[j] < b) {\n        const n1 = nrm(j - 1);\n        const n2 = nrm(j);\n        const l = Math.hypot(n1[0] + n2[0], n1[1] + n2[1]) || 1;\n        out.push(shift(ring[j], [(n1[0] + n2[0]) / l, (n1[1] + n2[1]) / l]));\n      }\n    }\n    out.push(shift(at(b), nrm(segAt(b))));\n    out.push(at(s1));\n    while (v < pts.length && cum[v] <= s1) v++;\n  }\n  while (v < pts.length) out.push(ring[v++]);\n  // drop consecutive duplicates (e.g. a tab starting exactly on a vertex)\n  return out.filter((p, i) => {\n    const q = out[(i + out.length - 1) % out.length];\n    return Math.hypot(p[0] - q[0], p[1] - q[1]) > 1e-6;\n  });\n}\n\n/**\n * Score lines for folding the tabs: short slots (dashes) along each tab's\n * fold line, i.e. the original outline between the tab's ends. The dashes are\n * widely spaced so the tab doesn't tear off, and stop `margin` short of both\n * ends so they never meet the cut outline.\n */\nfunction scoreSlots(\n  pts: P[],\n  ranges: [number, number][],\n  dash: number = 3,\n  gap: number = 12,\n  margin: number = 1.5,\n  width: number = 0.3,\n): P[][] {\n  const ring: P[] = [...pts, pts[0]];\n  const cum = ringCum(pts);\n  const at = (s: number): P => {\n    let i = 0;\n    while (i < ring.length - 2 && cum[i + 1] <= s) i++;\n    const t = (s - cum[i]) / (cum[i + 1] - cum[i] || 1);\n    return [ring[i][0] + t * (ring[i + 1][0] - ring[i][0]), ring[i][1] + t * (ring[i + 1][1] - ring[i][1])];\n  };\n  const slots: P[][] = [];\n  for (const [s0, s1] of ranges) {\n    const len = s1 - s0 - 2 * margin;\n    if (len < 1) continue;\n    const n = Math.max(1, Math.floor((len + gap) / (dash + gap)));\n    const d = Math.min(dash, len);\n    let s = s0 + margin + (len - (n * d + (n - 1) * gap)) / 2;\n    for (let k = 0; k < n; k++, s += d + gap) {\n      const p = at(s);\n      const q = at(s + d);\n      const l = Math.hypot(q[0] - p[0], q[1] - p[1]) || 1;\n      const nx = (-(q[1] - p[1]) / l) * (width / 2);\n      const ny = ((q[0] - p[0]) / l) * (width / 2);\n      // clockwise, so it reads as a hole\n      slots.push([\n        [p[0] + nx, p[1] + ny],\n        [p[0] - nx, p[1] - ny],\n        [q[0] - nx, q[1] - ny],\n        [q[0] + nx, q[1] + ny],\n      ]);\n    }\n  }\n  return slots;\n}\n\n/**\n * The piece as one drawing: the tabbed outline with the score slots as holes.\n * Built directly as a compound blueprint (outline + holes) rather than with\n * boolean cuts, which are very slow with this many slots.\n */\nfunction withScores(outline: P[], slots: P[][]) {\n  const piece = polyDrawing(outline);\n  if (slots.length === 0) return piece;\n  return new replicad.Drawing(\n    new replicad.CompoundBlueprint([piece.innerShape, ...slots.map((s) => polyDrawing(s).innerShape)]),\n  );\n}\n\nfunction polyDrawing(pts: P[]) {\n  let pen = replicad.draw(pts[0]);\n  for (let i = 1; i < pts.length; i++) pen = pen.lineTo(pts[i]);\n  return pen.close();\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * Adds glue tabs to a flat outline (e.g. from crv.MeshUnroll) using the\n * \"first half of every edge\" rule: the outline is split into edges at its\n * sharp corners, and each edge gets tabs along its first half (walking the\n * outline counter-clockwise). When two pieces are glued along an edge they\n * run in opposite directions, so one piece's tabs always land on the other\n * piece's plain half - any piece can be glued to any other.\n * Each tab's fold line is scored with short slots that stop short of the cut.\n */\nfunction run(outline, tabWidth = 8, tabsPerHalfEdge = 3, cornerDeg = 25) {\n    return outline.onLeafs((leaf) => {\n        let pts = outlinePoints(leaf.geometry);\n        if (area(pts) < 0)\n            pts.reverse();\n        const n = pts.length;\n        // corners: vertices where the outline turns sharply\n        const corners = [];\n        for (let i = 0; i < n; i++) {\n            const a = pts[(i + n - 1) % n];\n            const b = pts[i];\n            const c = pts[(i + 1) % n];\n            let turn = Math.abs(Math.atan2(c[1] - b[1], c[0] - b[0]) - Math.atan2(b[1] - a[1], b[0] - a[0]));\n            if (turn > Math.PI)\n                turn = 2 * Math.PI - turn;\n            if (turn > (cornerDeg * Math.PI) / 180)\n                corners.push(i);\n        }\n        if (corners.length < 2)\n            throw new Error(`found ${corners.length} corners; lower cornerDeg`);\n        // start the outline at the first corner\n        pts = [...pts.slice(corners[0]), ...pts.slice(0, corners[0])];\n        const cum = ringCum(pts);\n        // corner positions along the outline, merging any within 3 mm of each other\n        const cs = [];\n        for (const c of corners.map((c) => cum[(c - corners[0] + n) % n]).sort((a, b) => a - b)) {\n            if (cs.length === 0 || c - cs[cs.length - 1] > 3)\n                cs.push(c);\n        }\n        console.log(`${n} outline points, ${cs.length} edges`);\n        const ranges = [];\n        for (let k = 0; k < cs.length; k++) {\n            const s0 = cs[k];\n            const s1 = k + 1 < cs.length ? cs[k + 1] : cum[n];\n            const start = s0 + 2;\n            const end = s0 + (s1 - s0) / 2 - 1;\n            const slot = (end - start) / tabsPerHalfEdge;\n            for (let j = 0; j < tabsPerHalfEdge; j++)\n                ranges.push([start + j * slot + 1, start + (j + 1) * slot - 1]);\n        }\n        // new Assembly without the source's heat-map metadata, which no longer matches\n        return new Assembly({ geometry: withScores(addTabs(pts, ranges, tabWidth), scoreSlots(pts, ranges)) });\n    });\n}\n/** Ordered outline points of a single-loop drawing, chained from its edges. */\nfunction outlinePoints(drawing) {\n    const segs = drawing.sketchOnPlane(\"XY\").wire.edges.map((e) => [\n        [e.startPoint.x, e.startPoint.y],\n        [e.endPoint.x, e.endPoint.y],\n    ]);\n    const dist = (p, q) => Math.hypot(p[0] - q[0], p[1] - q[1]);\n    const used = new Array(segs.length).fill(false);\n    const pts = [segs[0][0]];\n    let cur = segs[0][1];\n    used[0] = true;\n    for (let step = 1; step < segs.length; step++) {\n        pts.push(cur);\n        // nearest unused segment end to the current point\n        let best = -1;\n        let flip = false;\n        let bestD = Infinity;\n        for (let i = 0; i < segs.length; i++) {\n            if (used[i])\n                continue;\n            const da = dist(segs[i][0], cur);\n            const db = dist(segs[i][1], cur);\n            if (da < bestD)\n                [bestD, best, flip] = [da, i, false];\n            if (db < bestD)\n                [bestD, best, flip] = [db, i, true];\n        }\n        if (best < 0 || bestD > 0.01) {\n            console.warn(`outline chain broke after ${step} of ${segs.length} edges`);\n            break;\n        }\n        used[best] = true;\n        cur = flip ? segs[best][0] : segs[best][1];\n    }\n    return pts;\n}\nfunction area(pts) {\n    let s = 0;\n    for (let i = 0; i < pts.length; i++) {\n        const p = pts[i];\n        const q = pts[(i + 1) % pts.length];\n        s += p[0] * q[1] - q[0] * p[1];\n    }\n    return s / 2;\n}\n/** Cumulative arc length at each vertex of the closed outline (last = perimeter). */\nfunction ringCum(pts) {\n    const cum = [0];\n    for (let i = 1; i <= pts.length; i++) {\n        const a = pts[i - 1];\n        const b = pts[i % pts.length];\n        cum.push(cum[i - 1] + Math.hypot(b[0] - a[0], b[1] - a[1]));\n    }\n    return cum;\n}\n/**\n * Adds glue tabs to a closed counter-clockwise outline. Each range [s0, s1]\n * is an arc-length interval measured along the outline from pts[0]; the tab\n * follows the outline over that interval, pushed outward by `w`, with\n * 45-degree tapered ends so neighbouring tabs don't collide at corners.\n */\nfunction addTabs(pts, ranges, w) {\n    const ring = [...pts, pts[0]];\n    const cum = ringCum(pts);\n    const segAt = (s) => {\n        let i = 0;\n        while (i < ring.length - 2 && cum[i + 1] <= s)\n            i++;\n        return i;\n    };\n    const at = (s) => {\n        const i = segAt(s);\n        const t = (s - cum[i]) / (cum[i + 1] - cum[i] || 1);\n        return [ring[i][0] + t * (ring[i + 1][0] - ring[i][0]), ring[i][1] + t * (ring[i + 1][1] - ring[i][1])];\n    };\n    // outward (right-hand) unit normal of segment i\n    const nrm = (i) => {\n        const dx = ring[i + 1][0] - ring[i][0];\n        const dy = ring[i + 1][1] - ring[i][1];\n        const l = Math.hypot(dx, dy) || 1;\n        return [dy / l, -dx / l];\n    };\n    const shift = (p, n) => [p[0] + n[0] * w, p[1] + n[1] * w];\n    const out = [];\n    let v = 0;\n    for (const [s0, s1] of [...ranges].sort((a, b) => a[0] - b[0])) {\n        if (s1 - s0 < 1e-6)\n            continue;\n        while (v < pts.length && cum[v] < s0)\n            out.push(ring[v++]);\n        const taper = Math.min(w, (s1 - s0) / 3);\n        const a = s0 + taper;\n        const b = s1 - taper;\n        out.push(at(s0));\n        out.push(shift(at(a), nrm(segAt(a))));\n        for (let j = 1; j < pts.length; j++) {\n            if (cum[j] > a && cum[j] < b) {\n                const n1 = nrm(j - 1);\n                const n2 = nrm(j);\n                const l = Math.hypot(n1[0] + n2[0], n1[1] + n2[1]) || 1;\n                out.push(shift(ring[j], [(n1[0] + n2[0]) / l, (n1[1] + n2[1]) / l]));\n            }\n        }\n        out.push(shift(at(b), nrm(segAt(b))));\n        out.push(at(s1));\n        while (v < pts.length && cum[v] <= s1)\n            v++;\n    }\n    while (v < pts.length)\n        out.push(ring[v++]);\n    // drop consecutive duplicates (e.g. a tab starting exactly on a vertex)\n    return out.filter((p, i) => {\n        const q = out[(i + out.length - 1) % out.length];\n        return Math.hypot(p[0] - q[0], p[1] - q[1]) > 1e-6;\n    });\n}\n/**\n * Score lines for folding the tabs: short slots (dashes) along each tab's\n * fold line, i.e. the original outline between the tab's ends. The dashes are\n * widely spaced so the tab doesn't tear off, and stop `margin` short of both\n * ends so they never meet the cut outline.\n */\nfunction scoreSlots(pts, ranges, dash = 3, gap = 12, margin = 1.5, width = 0.3) {\n    const ring = [...pts, pts[0]];\n    const cum = ringCum(pts);\n    const at = (s) => {\n        let i = 0;\n        while (i < ring.length - 2 && cum[i + 1] <= s)\n            i++;\n        const t = (s - cum[i]) / (cum[i + 1] - cum[i] || 1);\n        return [ring[i][0] + t * (ring[i + 1][0] - ring[i][0]), ring[i][1] + t * (ring[i + 1][1] - ring[i][1])];\n    };\n    const slots = [];\n    for (const [s0, s1] of ranges) {\n        const len = s1 - s0 - 2 * margin;\n        if (len < 1)\n            continue;\n        const n = Math.max(1, Math.floor((len + gap) / (dash + gap)));\n        const d = Math.min(dash, len);\n        let s = s0 + margin + (len - (n * d + (n - 1) * gap)) / 2;\n        for (let k = 0; k < n; k++, s += d + gap) {\n            const p = at(s);\n            const q = at(s + d);\n            const l = Math.hypot(q[0] - p[0], q[1] - p[1]) || 1;\n            const nx = (-(q[1] - p[1]) / l) * (width / 2);\n            const ny = ((q[0] - p[0]) / l) * (width / 2);\n            // clockwise, so it reads as a hole\n            slots.push([\n                [p[0] + nx, p[1] + ny],\n                [p[0] - nx, p[1] - ny],\n                [q[0] - nx, q[1] - ny],\n                [q[0] + nx, q[1] + ny],\n            ]);\n        }\n    }\n    return slots;\n}\n/**\n * The piece as one drawing: the tabbed outline with the score slots as holes.\n * Built directly as a compound blueprint (outline + holes) rather than with\n * boolean cuts, which are very slow with this many slots.\n */\nfunction withScores(outline, slots) {\n    const piece = polyDrawing(outline);\n    if (slots.length === 0)\n        return piece;\n    return new replicad.Drawing(new replicad.CompoundBlueprint([piece.innerShape, ...slots.map((s) => polyDrawing(s).innerShape)]));\n}\nfunction polyDrawing(pts) {\n    let pen = replicad.draw(pts[0]);\n    for (let i = 1; i < pts.length; i++)\n        pen = pen.lineTo(pts[i]);\n    return pen.close();\n}\n"
