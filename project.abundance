eed.ids.forEach((id, k) => {\n        flat[id] = { x: seed.xs[k].x, y: seed.xs[k].y };\n        placed[id] = true;\n    });\n    const queue = seed.ids.flatMap((id) => incident[id]);\n    for (let head = 0; head < queue.length; head++) {\n        const tri = tris[queue[head]];\n        const open = tri.ids.filter((i) => !placed[i]);\n        if (open.length !== 1)\n            continue;\n        const v = open[0];\n        const p = placeFrom(bestHinge(v, incident[v], tris, placed, tri), v, flat, placed);\n        if (!p)\n            continue;\n        flat[v] = p;\n        placed[v] = true;\n        for (const t of incident[v])\n            queue.push(t);\n    }\n    for (let i = 0; i < nv; i++) {\n        if (!placed[i])\n            console.warn(`unroll: vertex ${i} of ${nv} is not connected to the mesh`);\n    }\n    return flat;\n}\nfunction bestHinge(v, candidates, tris, placed, fallback) {\n    let best = fallback;\n    let bestScore = -Infinity;\n    for (const t of candidates) {\n        const tri = tris[t];\n        const k = tri.ids.indexOf(v);\n        if (k < 0)\n            continue;\n        const i = (k + 1) % 3;\n        const j = (k + 2) % 3;\n        if (!placed[tri.ids[i]] || !placed[tri.ids[j]])\n            continue;\n        const edge = sq(tri.xs[j].x - tri.xs[i].x, tri.xs[j].y - tri.xs[i].y);\n        const reach = sq(tri.xs[k].x - tri.xs[i].x, tri.xs[k].y - tri.xs[i].y);\n        const score = reach > 0 ? edge / reach : Infinity;\n        if (score > bestScore) {\n            bestScore = score;\n            best = tri;\n        }\n    }\n    return best;\n}\nfunction sq(dx, dy) {\n    return dx * dx + dy * dy;\n}\nfunction placeFrom(tri, v, flat, placed) {\n    const { ids, xs } = tri;\n    const k = ids.indexOf(v);\n    const i = (k + 1) % 3;\n    const j = (k + 2) % 3;\n    if (!placed[ids[i]] || !placed[ids[j]])\n        return null;\n    const dx = xs[j].x - xs[i].x;\n    const dy = xs[j].y - xs[i].y;\n    const den = dx * dx + dy * dy;\n    if (den < 1e-12)\n        return null;\n    const ex = flat[ids[j]].x - flat[ids[i]].x;\n    const ey = flat[ids[j]].y - flat[ids[i]].y;\n    const sr = (ex * dx + ey * dy) / den;\n    const si = (ey * dx - ex * dy) / den;\n    const norm = Math.hypot(sr, si);\n    if (norm < 1e-12)\n        return null;\n    const cr = sr / norm;\n    const ci = si / norm;\n    const vx = xs[k].x - xs[i].x;\n    const vy = xs[k].y - xs[i].y;\n    return {\n        x: flat[ids[i]].x + cr * vx - ci * vy,\n        y: flat[ids[i]].y + ci * vx + cr * vy,\n    };\n}\nexport function canonicalise(flat) {\n    if (flat.length === 0)\n        return flat;\n    let cx = 0;\n    let cy = 0;\n    for (const p of flat) {\n        cx += p.x;\n        cy += p.y;\n    }\n    cx /= flat.length;\n    cy /= flat.length;\n    let sxx = 0;\n    let sxy = 0;\n    let syy = 0;\n    for (const p of flat) {\n        const dx = p.x - cx;\n        const dy = p.y - cy;\n        sxx += dx * dx;\n        sxy += dx * dy;\n        syy += dy * dy;\n    }\n    const ang = 0.5 * Math.atan2(2 * sxy, sxx - syy);\n    const co = Math.cos(-ang);\n    const si = Math.sin(-ang);\n    let minX = Infinity;\n    let minY = Infinity;\n    const out = flat.map((p) => {\n        const dx = p.x - cx;\n        const dy = p.y - cy;\n        const q = { x: co * dx - si * dy, y: si * dx + co * dy };\n        if (q.x < minX)\n            minX = q.x;\n        if (q.y < minY)\n            minY = q.y;\n        return q;\n    });\n    for (const q of out) {\n        q.x -= minX;\n        q.y -= minY;\n    }\n    return out;\n}\nexport function boundaryEdges(mesh) {\n    const used = new Map();\n    const key = (a, b) => (a < b ? `${a}-${b}` : `${b}-${a}`);\n    for (const [a, b, c] of mesh.tris) {\n        for (const [u, v] of [\n            [a, b],\n            [b, c],\n            [c, a],\n        ]) {\n            used.set(key(u, v), (used.get(key(u, v)) ?? 0) + 1);\n        }\n    }\n    const out = [];\n    for (const [a, b, c] of mesh.tris) {\n        for (const [u, v] of [\n            [a, b],\n            [b, c],\n            [c, a],\n        ]) {\n            if (used.get(key(u, v)) === 1)\n                out.push([u, v]);\n        }\n    }\n    return out;\n}\nexport function chainEdges(edges) {\n    const next = new Map();\n    const hasPredecessor = new Set();\n    for (const [u, v] of edges) {\n        next.set(u, v);\n        hasPredecessor.add(v);\n    }\n    const chains = [];\n    const visited = new Set();\n    const walk = (seed) => {\n        const chain = [seed];\n        visited.add(seed);\n        let cur = seed;\n        while (true) {\n            const to = next.get(cur);\n            if (to === undefined || to === seed)\n                break;\n            if (visited.has(to))\n                break;\n            chain.push(to);\n            visited.add(to);\n            cur = to;\n        }\n        if (next.get(cur) === seed && chain.length > 2)\n            chain.push(seed);\n        if (chain.length > 1)\n            chains.push(chain);\n    };\n    for (const [u] of next)\n        if (!hasPredecessor.has(u))\n            walk(u);\n    for (const [u] of next)\n        if (!visited.has(u))\n            walk(u);\n    return chains;\n}\nexport function boundaryLoop(mesh) {\n    const chains = chainEdges(boundaryEdges(mesh));\n    if (chains.length === 0)\n        return [];\n    return chains.map((loop) => {\n        return loop[0] === loop[loop.length - 1] ? loop.slice(0, -1) : loop;\n    });\n}\nexport function measureDistortion(mesh, flat) {\n    let squared = 0;\n    let count = 0;\n    let edgeMax = 0;\n    let area3d = 0;\n    let area2d = 0;\n    const triStrains = [];\n    for (const [a, b, c] of mesh.tris) {\n        const local = flattenTriangle(mesh, a, b, c);\n        for (const [u, v] of [\n            [a, b],\n            [b, c],\n            [c, a],\n        ]) {\n            const length3d = distance3d(mesh, u, v);\n            if (length3d === 0)\n                continue;\n            const p = flat.positions[u];\n            const q = flat.positions[v];\n            const ratio = Math.hypot(q.x - p.x, q.y - p.y) / length3d - 1;\n            squared += ratio * ratio;\n            count += 1;\n            edgeMax = Math.max(edgeMax, Math.abs(ratio));\n        }\n        area3d += local.area;\n        area2d += Math.abs(signedArea(flat.positions[a], flat.positions[b], flat.positions[c]));\n        triStrains.push(principalStrains(local, flat, a, b, c));\n    }\n    return {\n        edgeRms: count > 0 ? Math.sqrt(squared / count) : 0,\n        edgeMax,\n        areaRatio: area3d > 0 ? area2d / area3d : 1,\n        triStrains,\n    };\n}\nfunction flattenTriangle(mesh, a, b, c) {\n    const A = mesh.positions[a];\n    const B = mesh.positions[b];\n    const C = mesh.positions[c];\n    const ex = B.x - A.x, ey = B.y - A.y, ez = B.z - A.z;\n    const fx = C.x - A.x, fy = C.y - A.y, fz = C.z - A.z;\n    const ux = Math.hypot(ex, ey, ez);\n    const dot = ux > 0 ? (ex * fx + ey * fy + ez * fz) / ux : 0;\n    const nx = ey * fz - ez * fy;\n    const ny = ez * fx - ex * fz;\n    const nz = ex * fy - ey * fx;\n    const cross = Math.hypot(nx, ny, nz);\n    return { ux, vx: dot, vy: ux > 0 ? cross / ux : 0, area: cross / 2 };\n}\nfunction principalStrains(local, flat, a, b, c) {\n    const det = local.ux * local.vy;\n    if (det === 0)\n        return { e1: 0, e2: 0 };\n    const A = flat.positions[a];\n    const B = flat.positions[b];\n    const C = flat.positions[c];\n    const qx1 = B.x - A.x, qy1 = B.y - A.y;\n    const qx2 = C.x - A.x, qy2 = C.y - A.y;\n    const i00 = local.vy / det;\n    const i01 = -local.vx / det;\n    const i11 = local.ux / det;\n    const j00 = qx1 * i00;\n    const j01 = qx1 * i01 + qx2 * i11;\n    const j10 = qy1 * i00;\n    const j11 = qy1 * i01 + qy2 * i11;\n    const e = (j00 + j11) / 2;\n    const f = (j00 - j11) / 2;\n    const g = (j10 + j01) / 2;\n    const h = (j10 - j01) / 2;\n    const q = Math.hypot(e, h);\n    const r = Math.hypot(f, g);\n    const sigma1 = q + r;\n    const sigma2 = Math.abs(q - r);\n    // sigma1 >= sigma2, so e1 (tension) is always >= e2 (compression)\n    return { e1: sigma1 - 1, e2: sigma2 - 1 };\n}\nfunction signedArea(a, b, c) {\n    return ((b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x)) / 2;\n}\nfunction distance3d(mesh, u, v) {\n    const p = mesh.positions[u];\n    const q = mesh.positions[v];\n    return Math.hypot(q.x - p.x, q.y - p.y, q.z - p.z);\n}\n"
