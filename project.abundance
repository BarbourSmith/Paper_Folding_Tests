                  "interpreterVersion": 1,
                  "code": "/**\n * One latitude band of a sphere, approximated by the cone frustum through its\n * two edge circles, and developed flat into an annular sector (exact, since a\n * cone is developable). The same band is used for the north and south\n * hemispheres. lat2 = 90 gives the polar cap, drawn as a flat disc (the cap\n * cone is nearly flat and its seam gap is too thin for a tab).\n *\n * Glue tabs:\n * - seam tab on the right straight edge: closes the band into a cone.\n * - tabs on the inner (upper) arc: glue under the outer arc of the next band\n *   towards the pole (or under the polar disc).\n * - equator band only (lat1 = 0): tabs on every other slot of the outer arc.\n *   The north and south copies are the same piece flipped, so their tabs land\n *   in each other's gaps when the seams are lined up.\n * Each tab's fold line is scored with short slots that stop short of the cut.\n */\nfunction run(radius: number = 100, lat1: number = 45, lat2: number = 67.5, tabWidth: number = 8): Assembly {\n  const d = Math.PI / 180;\n  const r1 = radius * Math.cos(lat1 * d);\n  if (lat2 >= 90) {\n    // polar cap: flat disc with the circumference of the last band's inner edge\n    return new Assembly({ geometry: replicad.drawCircle(r1).translate(r1, r1) });\n  }\n  const r2 = radius * Math.cos(lat2 * d);\n  const dz = radius * (Math.sin(lat2 * d) - Math.sin(lat1 * d));\n  const slant = Math.hypot(r1 - r2, dz);\n  const outer = (r1 * slant) / (r1 - r2); // apex to wide edge\n  const inner = outer - slant; // apex to narrow edge\n  const theta = (2 * Math.PI * r1) / outer; // sector angle\n  const at = (rho: number, t: number): P => [rho * Math.cos(Math.PI / 2 + t), rho * Math.sin(Math.PI / 2 + t)];\n  // counter-clockwise outline: outer arc right->left, left edge in,\n  // inner arc left->right, right edge out (closing segment)\n  const seg = Math.max(16, Math.ceil(theta / d));\n  const pts: P[] = [];\n  for (let i = 0; i <= seg; i++) pts.push(at(outer, -theta / 2 + (theta * i) / seg));\n  for (let i = 0; i <= seg; i++) pts.push(at(inner, theta / 2 - (theta * i) / seg));\n  const cum = ringCum(pts);\n  const outerEnd = cum[seg];\n  const innerStart = cum[seg + 1];\n  const innerEnd = cum[2 * seg + 1];\n  const total = cum[pts.length];\n\n  const ranges: [number, number][] = [];\n  // seam tab\n  ranges.push([innerEnd + 2, total - 2]);\n  // inner arc tabs\n  const innerLen = innerEnd - innerStart;\n  const nIn = Math.max(3, Math.round(innerLen / 35));\n  const slotIn = innerLen / nIn;\n  for (let k = 0; k < nIn; k++) ranges.push([innerStart + k * slotIn + 1.5, innerStart + (k + 1) * slotIn - 1.5]);\n  // equator: alternating tabs on the outer arc\n  if (lat1 <= 0) {\n    const nOut = 2 * Math.max(2, Math.round(outerEnd / 80));\n    const slotOut = outerEnd / nOut;\n    for (let k = 0; k < nOut; k += 2) ranges.push([k * slotOut + 1.5, (k + 1) * slotOut - 1.5]);\n  }\n\n  // sit the piece's bounding box on the origin for easy layout\n  const outline = addTabs(pts, ranges, tabWidth);\n  const x0 = Math.min(...outline.map((p) => p[0]));\n  const y0 = Math.min(...outline.map((p) => p[1]));\n  const move = (ps: P[]): P[] => ps.map((p) => [p[0] - x0, p[1] - y0]);\n  const drawing = withScores(move(outline), scoreSlots(pts, ranges).map(move));\n  console.log(`slant ${slant.toFixed(2)}  outer R ${outer.toFixed(2)}  inner R ${inner.toFixed(2)}  angle ${(theta / d).toFixed(1)} deg`);\n  return new Assembly({ geometry: drawing });\n}\n\ntype P = [number, number];\n\n/** Cumulative arc length at each vertex of the closed outline (last = perimeter). */\nfunction ringCum(pts: P[]): number[] {\n  const cum = [0];\n  for (let i = 1; i <= pts.length; i++) {\n    const a = pts[i - 1];\n    const b = pts[i % pts.length];\n    cum.push(cum[i - 1] + Math.hypot(b[0] - a[0], b[1] - a[1]));\n  }\n  return cum;\n}\n\n/**\n * Adds glue tabs to a closed counter-clockwise outline. Each range [s0, s1]\n * is an arc-length interval measured along the outline from pts[0]; the tab\n * follows the outline over that interval, pushed outward by `w`, with\n * 45-degree tapered ends so neighbouring tabs don't collide at corners.\n */\nfunction addTabs(pts: P[], ranges: [number, number][], w: number): P[] {\n  const ring: P[] = [...pts, pts[0]];\n  const cum = ringCum(pts);\n  const segAt = (s: number) => {\n    let i = 0;\n    while (i < ring.length - 2 && cum[i + 1] <= s) i++;\n    return i;\n  };\n  const at = (s: number): P => {\n    const i = segAt(s);\n    const t = (s - cum[i]) / (cum[i + 1] - cum[i] || 1);\n    return [ring[i][0] + t * (ring[i + 1][0] - ring[i][0]), ring[i][1] + t * (ring[i + 1][1] - ring[i][1])];\n  };\n  // outward (right-hand) unit normal of segment i\n  const nrm = (i: number): P => {\n    const dx = ring[i + 1][0] - ring[i][0];\n    const dy = ring[i + 1][1] - ring[i][1];\n    const l = Math.hypot(dx, dy) || 1;\n    return [dy / l, -dx / l];\n  };\n  const shift = (p: P, n: P): P => [p[0] + n[0] * w, p[1] + n[1] * w];\n  const out: P[] = [];\n  let v = 0;\n  for (const [s0, s1] of [...ranges].sort((a, b) => a[0] - b[0])) {\n    if (s1 - s0 < 1e-6) continue;\n    while (v < pts.length && cum[v] < s0) out.push(ring[v++]);\n    const taper = Math.min(w, (s1 - s0) / 3);\n    const a = s0 + taper;\n    const b = s1 - taper;\n    out.push(at(s0));\n    out.push(shift(at(a), nrm(segAt(a))));\n    for (let j = 1; j < pts.length; j++) {\n      if (cum[j] > a && cum[j] < b) {\n        const n1 = nrm(j - 1);\n        const n2 = nrm(j);\n        const l = Math.hypot(n1[0] + n2[0], n1[1] + n2[1]) || 1;\n        out.push(shift(ring[j], [(n1[0] + n2[0]) / l, (n1[1] + n2[1]) / l]));\n      }\n    }\n    out.push(shift(at(b), nrm(segAt(b))));\n    out.push(at(s1));\n    while (v < pts.length && cum[v] <= s1) v++;\n  }\n  while (v < pts.length) out.push(ring[v++]);\n  // drop consecutive duplicates (e.g. a tab starting exactly on a vertex)\n  return out.filter((p, i) => {\n    const q = out[(i + out.length - 1) % out.length];\n    return Math.hypot(p[0] - q[0], p[1] - q[1]) > 1e-6;\n  });\n}\n\n/**\n * Score lines for folding the tabs: short slots (dashes) along each tab's\n * fold line, i.e. the original outline between the tab's ends. The dashes are\n * widely spaced so the tab doesn't tear off, and stop `margin` short of both\n * ends so they never meet the cut outline.\n */\nfunction scoreSlots(\n  pts: P[],\n  ranges: [number, number][],\n  dash: number = 3,\n  gap: number = 12,\n  margin: number = 1.5,\n  width: number = 0.3,\n): P[][] {\n  const ring: P[] = [...pts, pts[0]];\n  const cum = ringCum(pts);\n  const at = (s: number): P => {\n    let i = 0;\n    while (i < ring.length - 2 && cum[i + 1] <= s) i++;\n    const t = (s - cum[i]) / (cum[i + 1] - cum[i] || 1);\n    return [ring[i][0] + t * (ring[i + 1][0] - ring[i][0]), ring[i][1] + t * (ring[i + 1][1] - ring[i][1])];\n  };\n  const slots: P[][] = [];\n  for (const [s0, s1] of ranges) {\n    const len = s1 - s0 - 2 * margin;\n    if (len < 1) continue;\n    const n = Math.max(1, Math.floor((len + gap) / (dash + gap)));\n    const d = Math.min(dash, len);\n    let s = s0 + margin + (len - (n * d + (n - 1) * gap)) / 2;\n    for (let k = 0; k < n; k++, s += d + gap) {\n      const p = at(s);\n      const q = at(s + d);\n      const l = Math.hypot(q[0] - p[0], q[1] - p[1]) || 1;\n      const nx = (-(q[1] - p[1]) / l) * (width / 2);\n      const ny = ((q[0] - p[0]) / l) * (width / 2);\n      // clockwise, so it reads as a hole\n      slots.push([\n        [p[0] + nx, p[1] + ny],\n        [p[0] - nx, p[1] - ny],\n        [q[0] - nx, q[1] - ny],\n        [q[0] + nx, q[1] + ny],\n      ]);\n    }\n  }\n  return slots;\n}\n\n/**\n * The piece as one drawing: the tabbed outline with the score slots as holes.\n * Built directly as a compound blueprint (outline + holes) rather than with\n * boolean cuts, which are very slow with this many slots.\n */\nfunction withScores(outline: P[], slots: P[][]) {\n  const piece = polyDrawing(outline);\n  if (slots.length === 0) return piece;\n  return new replicad.Drawing(\n    new replicad.CompoundBlueprint([piece.innerShape, ...slots.map((s) => polyDrawing(s).innerShape)]),\n  );\n}\n\nfunction polyDrawing(pts: P[]) {\n  let pen = replicad.draw(pts[0]);\n  for (let i = 1; i < pts.length; i++) pen = pen.lineTo(pts[i]);\n  return pen.close();\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * One latitude band of a sphere, approximated by the cone frustum through its\n * two edge circles, and developed flat into an annular sector (exact, since a\n * cone is developable). The same band is used for the north and south\n * hemispheres. lat2 = 90 gives the polar cap, drawn as a flat disc (the cap\n * cone is nearly flat and its seam gap is too thin for a tab).\n *\n * Glue tabs:\n * - seam tab on the right straight edge: closes the band into a cone.\n * - tabs on the inner (upper) arc: glue under the outer arc of the next band\n *   towards the pole (or under the polar disc).\n * - equator band only (lat1 = 0): tabs on every other slot of the outer arc.\n *   The north and south copies are the same piece flipped, so their tabs land\n *   in each other's gaps when the seams are lined up.\n * Each tab's fold line is scored with short slots that stop short of the cut.\n */\nfunction run(radius = 100, lat1 = 45, lat2 = 67.5, tabWidth = 8) {\n    const d = Math.PI / 180;\n    const r1 = radius * Math.cos(lat1 * d);\n    if (lat2 >= 90) {\n        // polar cap: flat disc with the circumference of the last band's inner edge\n        return new Assembly({ geometry: replicad.drawCircle(r1).translate(r1, r1) });\n    }\n    const r2 = radius * Math.cos(lat2 * d);\n    const dz = radius * (Math.sin(lat2 * d) - Math.sin(lat1 * d));\n    const slant = Math.hypot(r1 - r2, dz);\n    const outer = (r1 * slant) / (r1 - r2); // apex to wide edge\n    const inner = outer - slant; // apex to narrow edge\n    const theta = (2 * Math.PI * r1) / outer; // sector angle\n    const at = (rho, t) => [rho * Math.cos(Math.PI / 2 + t), rho * Math.sin(Math.PI / 2 + t)];\n    // counter-clockwise outline: outer arc right->left, left edge in,\n    // inner arc left->right, right edge out (closing segment)\n    const seg = Math.max(16, Math.ceil(theta / d));\n    const pts = [];\n    for (let i = 0; i <= seg; i++)\n        pts.push(at(outer, -theta / 2 + (theta * i) / seg));\n    for (let i = 0; i <= seg; i++)\n        pts.push(at(inner, theta / 2 - (theta * i) / seg));\n    const cum = ringCum(pts);\n    const outerEnd = cum[seg];\n    const innerStart = cum[seg + 1];\n    const innerEnd = cum[2 * seg + 1];\n    const total = cum[pts.length];\n    const ranges = [];\n    // seam tab\n    ranges.push([innerEnd + 2, total - 2]);\n    // inner arc tabs\n    const innerLen = innerEnd - innerStart;\n    const nIn = Math.max(3, Math.round(innerLen / 35));\n    const slotIn = innerLen / nIn;\n    for (let k = 0; k < nIn; k++)\n        ranges.push([innerStart + k * slotIn + 1.5, innerStart + (k + 1) * slotIn - 1.5]);\n    // equator: alternating tabs on the outer arc\n    if (lat1 <= 0) {\n        const nOut = 2 * Math.max(2, Math.round(outerEnd / 80));\n        const slotOut = outerEnd / nOut;\n        for (let k = 0; k < nOut; k += 2)\n            ranges.push([k * slotOut + 1.5, (k + 1) * slotOut - 1.5]);\n    }\n    // sit the piece's bounding box on the origin for easy layout\n    const outline = addTabs(pts, ranges, tabWidth);\n    const x0 = Math.min(...outline.map((p) => p[0]));\n    const y0 = Math.min(...outline.map((p) => p[1]));\n    const move = (ps) => ps.map((p) => [p[0] - x0, p[1] - y0]);\n    const drawing = withScores(move(outline), scoreSlots(pts, ranges).map(move));\n    console.log(`slant ${slant.toFixed(2)}  outer R ${outer.toFixed(2)}  inner R ${inner.toFixed(2)}  angle ${(theta / d).toFixed(1)} deg`);\n    return new Assembly({ geometry: drawing });\n}\n/** Cumulative arc length at each vertex of the closed outline (last = perimeter). */\nfunction ringCum(pts) {\n    const cum = [0];\n    for (let i = 1; i <= pts.length; i++) {\n        const a = pts[i - 1];\n        const b = pts[i % pts.length];\n        cum.push(cum[i - 1] + Math.hypot(b[0] - a[0], b[1] - a[1]));\n    }\n    return cum;\n}\n/**\n * Adds glue tabs to a closed counter-clockwise outline. Each range [s0, s1]\n *