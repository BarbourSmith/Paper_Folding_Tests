                  "interpreterVersion": 1,
                  "code": "/**\n * One of the 6 identical patches you get by projecting a cube onto the sphere\n * (like a 6-panel ball). It is the part of the sphere inside the square\n * pyramid from the centre through the cube face on -X, returned as a Face\n * for crv.MeshUnroll. -X keeps the sphere's seam and poles out of the patch.\n */\nfunction run(radius: number = 100): Assembly {\n  const big = radius * 3;\n  const a = Math.PI / 4;\n  const p = (t: number): [number, number] => [big * Math.cos(Math.PI + t), big * Math.sin(Math.PI + t)];\n  const wedgeXY = replicad\n    .draw([0, 0])\n    .lineTo(p(-a))\n    .lineTo(p(a))\n    .close()\n    .sketchOnPlane(\"XY\", [0, 0, -big])\n    .extrude(2 * big);\n  // same wedge turned 90 deg about X: bounds the patch in Z instead of Y\n  const wedgeXZ = wedgeXY.clone().rotate(90, [0, 0, 0], [1, 0, 0]);\n  const patch = replicad.makeSphere(radius).intersect(wedgeXY).intersect(wedgeXZ);\n  const faces = patch.faces.filter((f) => f.geomType === \"SPHERE\");\n  if (faces.length !== 1) throw new Error(`expected 1 spherical face, got ${faces.length}`);\n  return new Assembly({ geometry: faces[0] });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * One of the 6 identical patches you get by projecting a cube onto the sphere\n * (like a 6-panel ball). It is the part of the sphere inside the square\n * pyramid from the centre through the cube face on -X, returned as a Face\n * for crv.MeshUnroll. -X keeps the sphere's seam and poles out of the patch.\n */\nfunction run(radius = 100) {\n    const big = radius * 3;\n    const a = Math.PI / 4;\n    const p = (t) => [big * Math.cos(Math.PI + t), big * Math.sin(Math.PI + t)];\n    const wedgeXY = replicad\n        .draw([0, 0])\n        .lineTo(p(-a))\n        .lineTo(p(a))\n        .close()\n        .sketchOnPlane(\"XY\", [0, 0, -big])\n        .extrude(2 * big);\n    // same wedge turned 90 deg about X: bounds the patch in Z instead of Y\n    const wedgeXZ = wedgeXY.clone().rotate(90, [0, 0, 0], [1, 0, 0]);\n    const patch = replicad.makeSphere(radius).intersect(wedgeXY).intersect(wedgeXZ);\n    const faces = patch.faces.filter((f) => f.geomType === \"SPHERE\");\n    if (faces.length !== 1)\n        throw new Error(`expected 1 spherical face, got ${faces.length}`);\n    return new Assembly({ geometry: faces[0] });\n}\n"
