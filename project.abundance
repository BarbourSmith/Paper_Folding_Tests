              "interpreterVersion": 1,
              "code": "/** Linear pattern: `count` copies of `shape`, copy i moved i*(dx, dy). */\nfunction run(shape: Assembly, count: number = 12, dx: number = 0, dy: number = 56): Assembly {\n  const copies: Assembly[] = [];\n  for (let i = 0; i < count; i++) {\n    copies.push(\n      shape.onLeafs((leaf) => new Assembly({ ...leaf, geometry: leaf.geometry.clone().translate(dx * i, dy * i, 0) })),\n    );\n  }\n  return new Assembly({ geometry: copies });\n}\n",
              "compiledCode": "\"use strict\";\n/** Linear pattern: `count` copies of `shape`, copy i moved i*(dx, dy). */\nfunction run(shape, count = 12, dx = 0, dy = 56) {\n    const copies = [];\n    for (let i = 0; i < count; i++) {\n        copies.push(shape.onLeafs((leaf) => new Assembly({ ...leaf, geometry: leaf.geometry.clone().translate(dx * i, dy * i, 0) })));\n    }\n    return new Assembly({ geometry: copies });\n}\n"
